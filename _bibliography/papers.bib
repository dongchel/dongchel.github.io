@misc{shin_quantum_2026,
	title = {Quantum optics of frequency comb metrology},
	copyright = {arXiv.org perpetual, non-exclusive license},
	html = {https://arxiv.org/abs/2605.16702},
	doi = {10.48550/ARXIV.2605.16702},
	abstract = {Frequency combs enable precision measurements across timekeeping, spectroscopy, ranging and astronomy, and are now extending to integrated and field-deployable platforms. Realizing their full performance demands a comprehensive account of the quantum noise that arises when broadband optical fields are converted into finite-bandwidth electrical signals. Here we present a rigorous first-principles quantum-mechanical framework for optical frequency-comb metrology based on continuous-mode field quantization and a comb-line-resolved description of quantum fluctuations. The theory describes how quantum fluctuations of the comb field are transduced into electrical measurement noise. We apply the framework to two canonical settings, optical frequency division (OFD) and dual-comb spectroscopy (DCS), where it reveals two effects beyond semiclassical reach: a dependence of the OFD standard quantum limit on the comb spectral envelope, and a cyclostationary noise penalty that obstructs straightforward squeezing in DCS. These insights identify practical, resource-efficient routes to quantum enhancement through engineered comb states, laying a foundation for the design of next-generation frequency combs operating at and beyond standard quantum limits.},
	urldate = {2026-05-20},
	publisher = {arXiv},
	author = {Shin, Dong-Chel and Ng, Edwin and Suh, Myoung-Gyun and Sudhir, Vivishek},
	year = {2026},
	keywords = {FOS: Physical sciences, Quantum Physics (quant-ph)},
  preview = {quantum-comb.png}
}

@article{shin_compact_2026,
	title = {Compact, robust all-fiber platform for 1-{Hz}-linewidth synchronization of optical frequency combs using single comb line extraction},
	volume = {203},
	issn = {00303992},
	html = {https://www.sciencedirect.com/science/article/abs/pii/S0030399226008777},
	doi = {10.1016/j.optlastec.2026.115526},
	abstract = {A dual-comb interferometer, composed of a pair of coherent frequency combs, has emerged as a powerful tool for high-precision spectroscopy, tomography, and absolute distance metrology. Achieving high mutual coherence between two frequency combs is a pre-requisite for precise, accurate, and sensitive dual-comb applications and has traditionally been done by locking the combs to ultra-stable continuous-wave (CW) lasers with a reference cavity, despite the associated instrumental challenges. Here, we present a compact, all-fiber platform for synchronizing optical frequency combs using comb line extraction. Instead of employing additional ultra-stable lasers, we extract two comb lines from an optical frequency comb by injection locking to off-the-shelf diode lasers. These comb lines then beat with the other frequency comb, allowing the detection and suppression of the relative phase fluctuations through active feedback controls. Out-of-loop measurements show that the relative phase noise reaches –60 dBc/Hz at 10 Hz and –80 dBc/Hz at 10 kHz offset frequency, with a modified Allan deviation on the order 10–16 at 0.1 s averaging. Additionally, the integrated relative phase error between the pulses of the two frequency combs is only 23 µrad (37 fs in timing jitter) over the integration. As a demonstration of a dual-comb interferometer, we perform the multi-heterodyne measurements in the frequency domain, resolving 1-Hz linewidths between the two combs. This indicates a mutual coherence time of over 1 s, which is comparable to that of ultra-stable lasers.},
	urldate = {2026-05-20},
	journal = {Optics \& Laser Technology},
	author = {Shin, Dong-Chel and Yang, Jaewon and Lee, Dong Il and Kang, Guseon and Kim, Seung-Woo and Kim, Young-Jin},
	year = {2026},
	pages = {115526},
  preview = {comb-to-comb.png},
}

